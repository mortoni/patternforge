{
  "agent": "cursor",
  "workingDirectory": ".",
  "packageManager": "pnpm",
  "nodeVersion": "20",
  "reactDoctorVersion": "latest",
  "verificationScripts": [
    "lint",
    "typecheck",
    "test",
    "build"
  ],
  "skipMissingVerificationScripts": true,
  "maxChangedFiles": 8,
  "maxChangedLines": 400,
  "selection": {
    "severities": [
      "error",
      "warning"
    ],
    "categoryPriority": [
      "Security",
      "Bugs",
      "Accessibility",
      "Performance",
      "Maintainability"
    ],
    "includeCategories": [],
    "excludeCategories": [],
    "includeRules": [],
    "excludeRules": [
      "plugin-update-trust-risk",
      "no-vulnerable-react-server-components"
    ]
  }
}
